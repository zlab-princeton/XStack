# XStack configuration. Copy to config.env (gitignored); harness/tpu_env.sh reads it.

# Where the agents' homes, the ledger and temporary files go (default: <repo>/work).
XSTACK_WORK=

# The TPU VM the cells run on (one machine per concurrent cell). The scripts reach it with gcloud
# and ssh; XSTACK_TPU_IPS (worker external IPs, space separated) skips the gcloud lookup.
XSTACK_TPU_NAME=
XSTACK_TPU_ZONE=
XSTACK_TPU_USER=
XSTACK_TPU_KEY=~/.ssh/id_rsa
XSTACK_TPU_IPS=
# Accelerator label (v6e-8, v4-8, v5p-8 ...) for the access document and the rows' `machine` field, when the
# TPU name does not carry it.
XSTACK_TPU_ACCEL=

# The python that has torch, for the weight-load check of a passing submission (default: python3).
# The libraries a source model needs beyond torch sit in one site-packages directory per family
# (EXTRA_SITES in harness/weight_load_registry.py, under $XSTACK_WORK/torch_sites/<name>);
# `export XSTACK_TORCH_SITE_<NAME>=<dir>` (NAME the key, upper-cased) points one elsewhere, and
# `export XSTACK_TORCH_LOWMEM=1` builds the 1.4B-parameter nanochat_core reference in bf16 for the check.
XSTACK_TORCH_PYTHON=

# Agent launchers: Codex uses `codex login`; Claude Code and the Anthropic-compatible providers read
# $XSTACK_WORK/secrets/<provider>.env (see README, "Agents").
